<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fluff" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fluff_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Fluff.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fluff_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Fluff</item>
    </style>
</resources>
